# Rivet web application configuration.
# Everything is optional while deployments/studionet.json carries the canonical
# address. Any value set here overrides the deployment record, so changing the
# contract address never requires a code change.

# Deployed Rivet Intelligent Contract address on Studionet.
VITE_RIVET_CONTRACT=

# Network pins. The app refuses to boot on any other chain or RPC.
VITE_GENLAYER_CHAIN_ID=61999
VITE_GENLAYER_RPC_URL=https://studio.genlayer.com/api
VITE_GENLAYER_EXPLORER=https://explorer-studio.genlayer.com
